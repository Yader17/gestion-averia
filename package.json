{
  "name": "gestionaverias",
  "version": "1.0.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web",
    "eas:login": "cross-env EAS_NO_VCS=1 npx eas-cli login",
    "eas:whoami": "cross-env EAS_NO_VCS=1 npx eas-cli whoami",
    "build:android:preview": "cross-env EAS_NO_VCS=1 npx eas-cli build -p android --profile preview",
    "build:android:production": "cross-env EAS_NO_VCS=1 npx eas-cli build -p android --profile production",
    "build:android:local-apk": "cross-env EAS_NO_VCS=1 npx eas-cli build -p android --profile preview --local",
    "electron:dev": "npx expo start --web & npx electron electron/main.js --dev",
    "electron:build": "npx expo export --platform web && npx electron-builder --dir --win",
    "electron:build-installer": "npx expo export --platform web && npx electron-builder --win",
    "electron": "npx electron electron/main.js --dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "leaflet": "^1.9.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "build": {
    "appId": "com.gestionaverias.app",
    "productName": "Gestion de Averias",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "dist/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis"
    }
  }
}
