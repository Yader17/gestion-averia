{
  "expo": {
    "name": "GestionAverias",
    "slug": "GestionAverias",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F9FD"
    },
    "ios": {
      "bundleIdentifier": "com.gestionaverias.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F9FD"
      },
      "package": "com.gestionaverias.app",
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite adjuntar fotos a cada avería para incluirlas en el reporte.",
          "cameraPermission": "Permite tomar fotos de la avería y añadirlas al reporte."
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "d07a40ab-47eb-44f1-a149-3da4bc33457f"
      },
      "supportContact": "",
      "backend": {
        "url": "https://tsftpnfgvnnqhhmdhlcz.supabase.co"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d07a40ab-47eb-44f1-a149-3da4bc33457f"
    }
  }
}
